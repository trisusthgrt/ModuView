# Server Configuration
PORT=5000

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/video-app
# Or use MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/video-app

# JWT Secret (change this to a random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# File Upload Configuration
UPLOAD_DIR=uploads

# Frontend URL (for CORS and Socket.io)
FRONTEND_URL=http://localhost:5173

# Optional FFmpeg / FFprobe features (Step 7)
# If ffprobe is available, we will extract video metadata during processing.
# If ENABLE_TRANSCODE=true and ffmpeg is available, we will generate an MP4 copy for streaming.
ENABLE_TRANSCODE=false
